# ingestion-lambda — Module B Zero-ETL ingestion pipeline
#
# Triggered when a user uploads a data file (CSV/Excel/JSON) to:
#   s3://<datasets_bucket>/uploads/<tenant_id>/<filename>
#
# The Lambda:
#   1. Downloads and parses the file with pandas
#   2. Calls Claude API (function-calling) to infer schema and field descriptions
#   3. Generates column embeddings via Amazon Bedrock Titan Embeddings V2
#   4. Stores results to S3: s3://<artifacts_bucket>/module_b/<tenant_id>/<table_name>/
#
# Prerequisites:
#   - Enable Bedrock model access: AWS Console → Bedrock → Model access → Amazon Titan Embeddings V2
#   - Store Anthropic API key in Secrets Manager: alibi/anthropic-api-key → {"api_key": "sk-ant-..."}

locals {
  fn_name = "alibi-ingest-${var.environment}"
}

resource "aws_lambda_function" "ingest" {
  function_name = local.fn_name
  role          = var.role_arn
  runtime       = "python3.11"
  handler       = "module_b.lambda_ingest.handler"
  timeout       = var.lambda_timeout_seconds
  memory_size   = var.lambda_memory_mb

  # Lambda code package: module_b/ + lambda_handlers/ + common/ zipped for Lambda.
  # Build with: terraform apply -target=module.ingestion_lambda (generates build_ingest_zip.ps1)
  # then run: .\build\build_ingest_zip.ps1
  s3_bucket = var.artifacts_bucket
  s3_key    = "code/lambda_ingest.zip"

  ephemeral_storage {
    size = 1024
  }

  environment {
    variables = {
      ARTIFACTS_BUCKET      = var.artifacts_bucket
      DATASETS_BUCKET       = var.datasets_bucket
      ANTHROPIC_SECRET_NAME = var.anthropic_secret_name
      AWS_BEDROCK_REGION    = var.aws_region
    }
  }

  tags = {
    Project     = "alibi"
    Environment = var.environment
    Module      = "module_b"
  }

  lifecycle {
    ignore_changes = [s3_object_version]
  }
}

# S3 trigger: fire when a file lands in uploads/
# Build script — packages module_b + common + lambda_handlers into a Lambda zip
resource "local_file" "build_ingest_zip" {
  filename        = "${path.root}/build/build_ingest_zip.ps1"
  file_permission = "0644"
  content         = <<-EOT
    # Auto-generated by Terraform.
    # Packages module_b/, common/, and lambda_handlers/ into a Lambda-compatible .zip.
    # Run from your terminal BEFORE running terraform apply on ingestion-lambda.
    $ErrorActionPreference = "Stop"
    # Resolved via git instead of a fixed "..\..\..\..\.." hop count, so this
    # script works regardless of which root's build/ directory it's generated
    # into (ML/terraform/envs/dev, or terraform/envs/dev in the unified root
    # — they sit at different depths from the repo root).
    $RepoRoot         = (& git rev-parse --show-toplevel) -replace '/', '\'
    $SrcDir           = Join-Path $RepoRoot "ML\src"
    $OutZip           = Join-Path $RepoRoot "ml-lambda-ingest.zip"
    $ARTIFACTS_BUCKET = "${var.artifacts_bucket}"

    Write-Host "[ingest-zip] creating $OutZip"
    if (Test-Path $OutZip) { Remove-Item $OutZip }
    Push-Location $SrcDir
    Compress-Archive -Path module_b,common,lambda_handlers -DestinationPath $OutZip
    Pop-Location

    Write-Host "[ingest-zip] uploading to s3://$ARTIFACTS_BUCKET/code/lambda_ingest.zip"
    aws s3 cp $OutZip `
      s3://$ARTIFACTS_BUCKET/code/lambda_ingest.zip `
      --profile alibi --no-verify-ssl

    Write-Host "[ingest-zip] done -- now run: terraform apply -target=module.ingestion_lambda"
  EOT
}

resource "aws_lambda_permission" "s3_trigger" {
  statement_id  = "AllowS3InvokeIngest-${var.environment}"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.ingest.function_name
  principal     = "s3.amazonaws.com"
  source_arn    = "arn:aws:s3:::${var.datasets_bucket}"
}

resource "aws_s3_bucket_notification" "uploads" {
  bucket = var.datasets_bucket

  lambda_function {
    lambda_function_arn = aws_lambda_function.ingest.arn
    events              = ["s3:ObjectCreated:*"]
    filter_prefix       = "uploads/"
  }

  depends_on = [aws_lambda_permission.s3_trigger]
}
