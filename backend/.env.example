# Copy to backend/.env and fill in. backend/.env is gitignored — never commit
# real secrets. Settings are read with the ALIBI_ prefix (see app/core/config.py).

# Postgres DSN. LEAVE UNSET to run against the in-memory fixtures (no database
# needed — tests and a quick local run work as-is).
#
# For local dev against the real RDS, open the SSM tunnel first and point at 127.0.0.1:5433. Use 127.0.0.1, NOT
# localhost: localhost can resolve to IPv6 (::1) first, but the SSM tunnel
# only listens on IPv4, so the driver stalls ~120s before falling back.
# The password comes from Secrets Manager — never hardcode it anywhere but
# this local .env. Quote the whole value so special chars (e.g. '#') survive.
# ALIBI_DATABASE_URL="host=127.0.0.1 port=5433 dbname=alibi user=alibi_admin password=YOUR_PASSWORD sslmode=require"

# Comma-separated allowed CORS origins (defaults to http://localhost:5173).
# ALIBI_ALLOWED_ORIGINS=http://localhost:5173

# Local-dev convenience: run `alembic upgrade head` automatically on app
# startup (only takes effect when ALIBI_DATABASE_URL above is also set).
# Saves a manual `alembic upgrade head` after pulling someone else's new
# migration. NEVER set this for the deployed Lambda — it migrates via an
# explicit one-shot invoke from backend-deploy.yml instead (see app/main.py),
# specifically to avoid concurrent cold starts racing to run DDL.
# ALIBI_AUTO_MIGRATE=1

# ---------------------------------------------------------------------------
# Verification-code email (app/core/mailer.py)
# ---------------------------------------------------------------------------
# Plain SMTP from the project's own mailbox — no mail service, no AWS. For Gmail:
# turn on 2-Step Verification on the account, create an *app password*
# (Google Account → Security → App passwords) and paste its 16 characters here.
# LEAVE THE PASSWORD UNSET to skip sending: the code is printed in the server
# log instead, which is all local development needs.
# ALIBI_SMTP_USER=alibi.pfi@gmail.com
# ALIBI_SMTP_PASSWORD="abcd efgh ijkl mnop"
# Defaults, only for a non-Gmail server:
# ALIBI_SMTP_HOST=smtp.gmail.com
# ALIBI_SMTP_PORT=587
# ALIBI_MAIL_FROM=alibi.pfi@gmail.com

# ---------------------------------------------------------------------------
# Module A — Text-to-SQL (app/services/text2sql/)
# ---------------------------------------------------------------------------
# Every model call goes to AWS Bedrock (ALIBI is AWS-only since 2026-10-05).
# There is NO key and NO endpoint URL: boto3 authenticates with your normal AWS
# credentials (the `default` profile, or AWS_PROFILE), and the deployed Lambdas
# use their IAM roles. All a model needs is its id.
#
# REQUIRED to ask a question. There is no fixture fallback: with it unset,
# `prepare` returns 503. ALIBI has no offline mode. (The test suite stays free
# by stubbing the transport and blanking these ids; see tests/conftest.py.)
#
# The Bedrock model Module A uses when ALIBI_TEXT2SQL_PROVIDER is bedrock. A
# cross-region inference-profile id ("us." prefix) is what Bedrock serves Claude through.
# ALIBI_TEXT2SQL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Timeout for the model call, in seconds (default 20). The Lambda itself dies at
# 29s (API Gateway HTTP API's hard ceiling), so anything above ~25 here is
# unreachable in the deployed API. Locally you can raise it freely.
# ALIBI_TEXT2SQL_TIMEOUT_SECONDS=20

# Which prompt shape to send. MUST match the model pointed at above — see
# app/services/text2sql/formats.py. Two formats are registered:
#
#   sql-create-context-v1   the first qwen3 fine-tune (trained on Azure, retired
#                           2026-10-05). Reads the model's SQL as MySQL.
#   generic-chat-v1         any general chat model used as Module A —
#                           gpt-4o-mini, gpt-5.4-mini, Claude, a local Llama.
#                           Reads the SQL as DuckDB.
#
# ⚠ SET THIS WHENEVER YOU CHANGE THE MODEL. Pointing a general chat model
# at `sql-create-context-v1` does not fail — it silently corrupts the query. The
# MySQL reading rewrites a quoted *identifier* into a string *literal*:
#
#     model writes    SELECT "Total Revenue" FROM ds_a
#     what runs       SELECT 'Total Revenue' FROM ds_a
#
# which parses, passes the guardrail, executes without error, and returns the
# same constant text on every row. Nothing reports a problem.
#
# A general model (the Claude default above) → generic-chat-v1.
# ALIBI_TEXT2SQL_PROMPT_FORMAT=generic-chat-v1

# The fine-tuned adapters on SageMaker (app/core/sagemaker.py) — one endpoint
# for Module A's SQL and Module C's chart. Billed while it has a copy up; it
# scales to zero when idle and a run wakes it (minutes).
# ALIBI_TEXT2SQL_PROVIDER=sagemaker              # needs the format below
# ALIBI_TEXT2SQL_PROMPT_FORMAT=qwen-bird-spider-v1
# ALIBI_VISUALIZATION_PROVIDER=sagemaker
# ALIBI_SAGEMAKER_ENDPOINT_NAME=model-a-dev
# ALIBI_SAGEMAKER_INFERENCE_COMPONENT=model-a-dev-models
# ALIBI_MODEL_WAKE_WAIT_SECONDS=720


# ═══════════════════════════════════════════════════════════════════════════
# Module B — Zero-ETL ingestion
# ═══════════════════════════════════════════════════════════════════════════
# Every value below has a working default for LOCAL development. You only need
# to touch this block to (a) point at real S3 instead of the local disk, or
# (b) turn on the models. The pipeline runs end-to-end with none of it set.

# --- Storage (data plane: the Parquet tables) ------------------------------
# 'local'  → files under ALIBI_INGEST_LOCAL_DIR (default; no AWS needed)
# 's3'     → the ingest bucket; requires ALIBI_INGEST_BUCKET below
# ALIBI_OBJECT_STORE=local
# ALIBI_INGEST_LOCAL_DIR=.data
# ALIBI_INGEST_BUCKET=alibi-ingest-dev-213598695817
# ALIBI_AWS_REGION=us-east-1

# --- Job runner (how ingestion is executed) --------------------------------
# 'thread' → both stages back-to-back in this process (default; local dev)
# 'lambda' → the deployed S3 → SQS → processor → committer chain
#
# Ingestion runs in two stages that sit on opposite sides of the VPC boundary:
# the PROCESSOR parses the file and calls the model (needs internet, so it is
# outside the VPC), and the COMMITTER writes Postgres (needs the database, so
# it is inside). Hence two function names, invoked by different parties:
#   - the API re-invokes the PROCESSOR when a user retries a failed upload
#   - the processor invokes the COMMITTER when its own work is done
# In the normal deployed path the API invokes neither — S3's ObjectCreated
# event starts the chain. Locally neither is used at all.
# ALIBI_JOB_RUNNER=thread
# ALIBI_PROCESSOR_FUNCTION_NAME=alibi-ingest-processor-dev
# ALIBI_COMMITTER_FUNCTION_NAME=alibi-ingest-committer-dev

# --- Semantic schema inference ---------------------------------------------
# 'none'    → deterministic rules only. No model calls, no cloud, no cost.
#             Column names come from the file; confidence is reported honestly.
#             THIS IS THE DEFAULT.
# 'bedrock' → a chat model on Bedrock fills in semantic column names,
#             descriptions, Vega-Lite type hints and PK candidates, and an
#             embedding model produces the per-column vectors kept in pgvector.
# ALIBI_SCHEMA_INFERENCE_PROVIDER=none
# ALIBI_SCHEMA_INFERENCE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ALIBI_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Width of the stored vectors. MUST match the pgvector column in the
# 0003_module_b migration — changing it later is a migration, not an edit
# here. 512 works because Titan Text Embeddings V2 emits 256/512/1024 natively.
# ALIBI_EMBEDDING_DIMENSIONS=512

# --- Limits ----------------------------------------------------------------
# Platform ceilings, above every plan. The per-plan limits (Free/Pro: file
# size, datasets, queries, rows, history, export formats) live in the `plans`
# table and are enforced by app/services/billing.py.
# ALIBI_MAX_UPLOAD_MB=100
# ALIBI_MAX_ROWS_PER_TABLE=1000000
# Rows returned by GET /datasets/{id}/preview and the most any chat query
# returns, whatever the plan allows (a run's rows travel in its JSON).
# ALIBI_QUERY_ROW_LIMIT=5000

# --- Cost metering (cost_ledger) -------------------------------------------
# USD per 1M tokens for each model id the app calls. Every answered question is
# written to the ledger at these prices; a model missing here is metered at 0
# (and logged). Copy the prices from the Bedrock pricing page for your region.
# ALIBI_MODEL_PRICES_USD={"us.anthropic.claude-haiku-4-5-20251001-v1:0": {"input": 1.0, "output": 5.0}}
# Official ARS per USD and its date. Plan prices are USD reference values shown
# and charged in pesos at this rate; the ledger's cost_ars uses it too. Update
# both when the official rate moves — every peso price follows, no migration.
# ALIBI_USD_ARS_RATE=1550
# ALIBI_USD_ARS_RATE_AS_OF=2026-10-01

# --- Orchestrator: narrative synthesis (app/orchestrator) -------------------
# The general model that WRITES the answer (and, until Module C's adapter is
# wired in, the prompted chart), as opposed to Module A's, which writes the
# query. A Bedrock model id — no key, no endpoint.
#
# There is NO fallback. ALIBI has no offline mode: an answer is a real query
# narrated by a real model, or it is a 503.
# ALIBI_ORCHESTRATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- "Continuar con Google" (app/core/google_identity.py) ----
# The OAuth client id from the Google Cloud console (APIs & Services ->
# Credentials -> OAuth client ID, type "Web application"). Not a secret. Unset =
# no Google sign-in. The frontend needs the same value as VITE_GOOGLE_CLIENT_ID
# (frontend/.env.local) for the button to appear.
# ALIBI_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ---- Mercado Pago Checkout Pro (app/core/mercadopago.py) ----
# Paying for Pro. Create an application at mercadopago.com.ar/developers (Tus
# integraciones), product "Checkout Pro", and copy its TEST access token
# (Credenciales de prueba). A test token is the sandbox: pay with Mercado Pago's
# test cards, logged in as a test buyer user; no money moves. Production is the
# same variable with the production token. A secret. Unset = paid checkout is a
# 503 `payments_unavailable`; Free is unaffected.
# (A test token starts with APP_USR, like a production one.)
# ALIBI_MP_ACCESS_TOKEN=APP_USR-1234567890123456-101701-abcdef...

# ---- The agent harness (app/orchestrator/harness.py) ----
# A natural-language question is answered by a planner loop: a small fast model
# chooses the queries (Module A writes them), a bigger one writes the answer
# across their results — Haiku for Quick, Sonnet for Deep. No fallback: with no
# planner a question is a 503 `planner_unavailable`.
# ALIBI_PLANNER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ALIBI_SYNTHESIS_QUICK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ALIBI_SYNTHESIS_DEEP_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Hard caps per mode (SQL calls, planner turns, tokens). See app/core/config.py.
# ALIBI_HARNESS_QUICK_MAX_SQL=2
# ALIBI_HARNESS_DEEP_MAX_SQL=8

# This call happens during `execute`, AFTER the query already ran, so its
# budget is what's left of API Gateway's 29s ceiling.
# ALIBI_ORCHESTRATOR_TIMEOUT_SECONDS=15
# Not 0.0, unlike SQL generation: deterministic prose repeats the same three
# sentence skeletons forever. The grounding validator, not the sampler, is what
# keeps the figures honest.
# ALIBI_ORCHESTRATOR_TEMPERATURE=0.2

# --- LLM bridge (app/llm_bridge.py) -----------------------------------------
# Deployed-only, VPC topology: leave this UNSET locally. When set, both
# clients above invoke this Lambda instead of calling Bedrock directly — it's
# the other half of the split that lets Module A/the orchestrator work at all
# once db_enabled attaches this Lambda to the VPC (no NAT, no route to Bedrock).
# Provisioned by backend/terraform/modules/api-lambda when
# text2sql_enabled && db_enabled.
# ALIBI_LLM_BRIDGE_FUNCTION_NAME=alibi-llm-bridge-dev

# Rows that reach the narrative prompt. The spec forbids listing rows anyway,
# so a bigger sample buys tokens, not quality.
# ALIBI_NARRATIVE_MAX_PROMPT_ROWS=30
# 1-3 sentences plus the key-figure list.
# ALIBI_NARRATIVE_MAX_TOKENS=400
# Below this self-reported score a narrative is logged as weak. NOT a discard
# threshold — grounding is verified on every answer regardless.
# ALIBI_NARRATIVE_CONFIDENCE_THRESHOLD=0.6
