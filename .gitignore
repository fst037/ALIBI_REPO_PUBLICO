# Node / dependencias (por si se instala algo fuera de frontend/)
/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/*.local

# Contracts: bundle derivado (se regenera con `npm run contracts:bundle`).
# La fuente de verdad son contracts/root.yaml + los 5 archivos por dominio.
# El cliente Orval en frontend/src/lib/api/generated SÍ se commitea.
contracts/openapi.yaml

# Variables de entorno
.env
.env.local
.env.*.local

# Backend
backend/node_modules/
backend/dist/
backend/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema operativo
.DS_Store
Thumbs.db

# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Generated by training modules (contain infra-specific paths, credentials, not source artifacts)
ml/terraform/envs/dev/training_job_*.json
ml/terraform/envs/dev/launch_training_*.ps1

# Generated by backend terraform (build scripts, packaged Lambda zips)
backend/terraform/modules/api-lambda/placeholder.zip
backend/build.zip
backend/backend.zip
ml/terraform/envs/dev/build/
ml-deps-layer.zip

# Generated by the unified terraform root (same generated build scripts,
# now rooted here instead of backend/ml's own envs/dev) + one-time state
# migration scratch files
terraform/envs/dev/build/
terraform/envs/dev/lambda_response_*.json
_migration/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Any other virtualenv name/location (e.g. scratch check venvs like
# backend/.venv_check/) — the exact names above only match themselves.
.venv*/
venv*/
.pytest_cache/

# Backend Lambda build output (vendored deps, packaged by build_api_zip.ps1)
backend/build/

# ML data: generated outputs stay out; the raw dataset archives are committed
# (via Git LFS, see .gitattributes) — the exceptions are at the end of this file.
ML/data/*
!ML/data/README.md
!ML/data/download_datasets.sh
!ML/data/raw/
ML/mlruns/
mlruns/

# Local build artifacts
*.tar.gz
/tmp/

*.zip

# Local object store for Module B ingestion (ALIBI_OBJECT_STORE=local).
# Real uploaded files and their Parquet — never commit user data.
backend/.data/

# Raw dataset archives are committed (Git LFS). Must come after `*.zip`.
!ML/data/raw/*.zip
# ...but not what unpacking them produces (see ML/data/README.md).
ML/data/raw/bird_train.zip
ML/data/raw/spider/
ML/data/raw/bird/
ML/data/raw/nvbench/
